{
  "schema": {
    "name": "quality-suite",
    "version": 1
  },
  "name": "quality-v2",
  "sanity": {
    "invalidate_on_failure": true,
    "checks": [
      "dataset-hash",
      "split-leak",
      "checkpoint-recovery",
      "train-only-fitted-state",
      "finite-output",
      "family-color-contract"
    ]
  },
  "primary": {
    "directional": "solid-angle-normalized-l1-by-state",
    "energy": "integrated-relative-error-by-state-wo",
    "report": [
      "median",
      "p95"
    ],
    "reference_lines": {
      "directional_state_median": 0.05,
      "directional_state_p95": 0.15,
      "energy_median": 0.03
    }
  },
  "checkpoint_selection": {
    "strategy": "tail_guard",
    "metric": "directional_state_median",
    "tie_break": "directional_state_p95",
    "p95_guard_ratio": 1.25
  },
  "comparison": {
    "resampling_unit": "state",
    "minimum_matched_states": 20,
    "minimum_bootstrap_iterations": 1000,
    "confidence": 0.95
  }
}
