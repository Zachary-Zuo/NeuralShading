bool mdl_texture_clip_3d(float3 coordinate, int wrapU, int wrapV, int wrapW)
{
    return (wrapU == TEX_WRAP_CLIP && (coordinate.x < 0.0 || coordinate.x >= 1.0))
        || (wrapV == TEX_WRAP_CLIP && (coordinate.y < 0.0 || coordinate.y >= 1.0))
        || (wrapW == TEX_WRAP_CLIP && (coordinate.z < 0.0 || coordinate.z >= 1.0));
}

int3 tex_res_3d(int textureIndex, float frame)
{
    if (!tex_texture_isvalid(textureIndex) || frame != 0.0)
        return int3(0);
    uint width;
    uint height;
    uint depth;
    mdl_texture_dimensions_3d(textureIndex, width, height, depth);
    return int3(width, height, depth);
}

int tex_width_3d(int textureIndex, float frame)
{
    return tex_res_3d(textureIndex, frame).x;
}

int tex_height_3d(int textureIndex, float frame)
{
    return tex_res_3d(textureIndex, frame).y;
}

int tex_depth_3d(int textureIndex, float frame)
{
    return tex_res_3d(textureIndex, frame).z;
}

int tex_first_frame_3d(int textureIndex)
{
    return 0;
}

int tex_last_frame_3d(int textureIndex)
{
    return 0;
}

float4 tex_lookup_float4_3d(
    int textureIndex,
    float3 coordinate,
    int wrapU,
    int wrapV,
    int wrapW,
    float2 cropU,
    float2 cropV,
    float2 cropW,
    float frame)
{
    if (!tex_texture_isvalid(textureIndex) || frame != 0.0 || mdl_texture_clip_3d(coordinate, wrapU, wrapV, wrapW))
        return float4(0.0);
    uint width;
    uint height;
    uint depth;
    mdl_texture_dimensions_3d(textureIndex, width, height, depth);
    coordinate.x = mdl_apply_wrap_and_crop(coordinate.x, wrapU, cropU, width);
    coordinate.y = mdl_apply_wrap_and_crop(coordinate.y, wrapV, cropV, height);
    coordinate.z = mdl_apply_wrap_and_crop(coordinate.z, wrapW, cropW, depth);
    return mdl_texture_sample_level_3d(textureIndex, coordinate);
}

float3 tex_lookup_float3_3d(int textureIndex, float3 coordinate, int wrapU, int wrapV, int wrapW, float2 cropU, float2 cropV, float2 cropW, float frame)
{
    return tex_lookup_float4_3d(textureIndex, coordinate, wrapU, wrapV, wrapW, cropU, cropV, cropW, frame).xyz;
}

float3 tex_lookup_color_3d(int textureIndex, float3 coordinate, int wrapU, int wrapV, int wrapW, float2 cropU, float2 cropV, float2 cropW, float frame)
{
    return tex_lookup_float4_3d(textureIndex, coordinate, wrapU, wrapV, wrapW, cropU, cropV, cropW, frame).xyz;
}

float2 tex_lookup_float2_3d(int textureIndex, float3 coordinate, int wrapU, int wrapV, int wrapW, float2 cropU, float2 cropV, float2 cropW, float frame)
{
    return tex_lookup_float4_3d(textureIndex, coordinate, wrapU, wrapV, wrapW, cropU, cropV, cropW, frame).xy;
}

float tex_lookup_float_3d(int textureIndex, float3 coordinate, int wrapU, int wrapV, int wrapW, float2 cropU, float2 cropV, float2 cropW, float frame)
{
    return tex_lookup_float4_3d(textureIndex, coordinate, wrapU, wrapV, wrapW, cropU, cropV, cropW, frame).x;
}

float4 tex_texel_float4_3d(int textureIndex, int3 coordinate, float frame)
{
    const int3 size = tex_res_3d(textureIndex, frame);
    if (any(coordinate < int3(0)) || any(coordinate >= size))
        return float4(0.0);
    return mdl_texture_load_3d(textureIndex, coordinate);
}

float3 tex_texel_float3_3d(int textureIndex, int3 coordinate, float frame)
{
    return tex_texel_float4_3d(textureIndex, coordinate, frame).xyz;
}

float3 tex_texel_color_3d(int textureIndex, int3 coordinate, float frame)
{
    return tex_texel_float4_3d(textureIndex, coordinate, frame).xyz;
}

float2 tex_texel_float2_3d(int textureIndex, int3 coordinate, float frame)
{
    return tex_texel_float4_3d(textureIndex, coordinate, frame).xy;
}

float tex_texel_float_3d(int textureIndex, int3 coordinate, float frame)
{
    return tex_texel_float4_3d(textureIndex, coordinate, frame).x;
}
