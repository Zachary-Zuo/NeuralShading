uint mdl_read_argblock_word(uint wordOffset)
{
    const uint4 words = asuint(gMdlArgumentBlock[wordOffset >> 2]);
    switch (wordOffset & 3)
    {
    case 0: return words.x;
    case 1: return words.y;
    case 2: return words.z;
    default: return words.w;
    }
}

float mdl_read_argblock_as_float(int byteOffset)
{
    return asfloat(mdl_read_argblock_word(uint(byteOffset) >> 2));
}

double mdl_read_argblock_as_double(int byteOffset)
{
    const uint wordOffset = uint(byteOffset) >> 2;
    return asdouble(mdl_read_argblock_word(wordOffset), mdl_read_argblock_word(wordOffset + 1));
}

int mdl_read_argblock_as_int(int byteOffset)
{
    return asint(mdl_read_argblock_word(uint(byteOffset) >> 2));
}

uint mdl_read_argblock_as_uint(int byteOffset)
{
    return mdl_read_argblock_word(uint(byteOffset) >> 2);
}

bool mdl_read_argblock_as_bool(int byteOffset)
{
    const uint offset = uint(byteOffset);
    const uint value = mdl_read_argblock_word(offset >> 2);
    return (value & (0xffu << (8 * (offset & 3)))) != 0;
}

uint mdl_read_rodata_word(uint wordOffset)
{
    const uint4 words = asuint(gMdlRoData[wordOffset >> 2]);
    switch (wordOffset & 3)
    {
    case 0: return words.x;
    case 1: return words.y;
    case 2: return words.z;
    default: return words.w;
    }
}

float mdl_read_rodata_as_float(int byteOffset)
{
    return asfloat(mdl_read_rodata_word(uint(byteOffset) >> 2));
}

double mdl_read_rodata_as_double(int byteOffset)
{
    const uint wordOffset = uint(byteOffset) >> 2;
    return asdouble(mdl_read_rodata_word(wordOffset), mdl_read_rodata_word(wordOffset + 1));
}

int mdl_read_rodata_as_int(int byteOffset)
{
    return asint(mdl_read_rodata_word(uint(byteOffset) >> 2));
}

int mdl_read_rodata_as_uint(int byteOffset)
{
    return int(mdl_read_rodata_word(uint(byteOffset) >> 2));
}

bool mdl_read_rodata_as_bool(int byteOffset)
{
    const uint offset = uint(byteOffset);
    const uint value = mdl_read_rodata_word(offset >> 2);
    return (value & (0xffu << (8 * (offset & 3)))) != 0;
}

float3 mdl_adapt_normal(Shading_state_material state, float3 normal)
{
    if (all(normal == float3(0.0)))
        return normal;

    const float3 geometricNormal = normalize(state.geom_normal);
    const float signNormal = dot(normal, geometricNormal) >= 0.0 ? 1.0 : -1.0;
    const float3 orientedNormal = signNormal * normalize(normal);
    const float threshold = 0.1;
    const float cosine = dot(state.renderer_state.view_direction, orientedNormal);
    if (cosine <= threshold)
    {
        const float blend = saturate(cosine / threshold);
        return normalize(signNormal * lerp(geometricNormal, orientedNormal, blend));
    }
    return normal;
}

bool tex_texture_isvalid(int textureIndex)
{
    return textureIndex > 0 && textureIndex <= NCLS_MDL_TEXTURE_COUNT;
}

float mdl_apply_wrap_and_crop(float coordinate, int wrapMode, float2 crop, uint resolution)
{
    if (wrapMode != TEX_WRAP_REPEAT || any(crop != float2(0.0, 1.0)))
    {
        if (wrapMode == TEX_WRAP_REPEAT)
        {
            coordinate -= floor(coordinate);
        }
        else
        {
            if (wrapMode == TEX_WRAP_MIRRORED_REPEAT)
            {
                const float interval = floor(coordinate);
                if ((int(interval) & 1) != 0)
                    coordinate = 1.0 - (coordinate - interval);
                else
                    coordinate -= interval;
            }
            const float halfTexel = 0.5 / float(resolution);
            coordinate = clamp(coordinate, halfTexel, 1.0 - halfTexel);
        }
        coordinate = coordinate * (crop.y - crop.x) + crop.x;
    }
    return coordinate;
}

// Match the MDL integration used by falcor2.  The quintic remap keeps the
// hardware bilinear footprint but suppresses the visible linear interpolation
// shoulders that MDL's Falcor runtime deliberately avoids.
float2 mdl_apply_smootherstep_filter(float2 uv, uint2 size)
{
    float2 result = uv * size + 0.5;
    const float uInteger = floor(result.x);
    const float vInteger = floor(result.y);
    float uFraction = result.x - uInteger;
    float vFraction = result.y - vInteger;
    uFraction = uFraction * uFraction * uFraction
        * (uFraction * (uFraction * 6.0 - 15.0) + 10.0);
    vFraction = vFraction * vFraction * vFraction
        * (vFraction * (vFraction * 6.0 - 15.0) + 10.0);
    result.x = uInteger + uFraction;
    result.y = vInteger + vFraction;
    return (result - 0.5) / size;
}

bool mdl_texture_clip(float2 coordinate, int wrapU, int wrapV)
{
    return (wrapU == TEX_WRAP_CLIP && (coordinate.x < 0.0 || coordinate.x >= 1.0))
        || (wrapV == TEX_WRAP_CLIP && (coordinate.y < 0.0 || coordinate.y >= 1.0));
}

int2 tex_res_2d(int textureIndex, int2 uvTile, float frame)
{
    if (!tex_texture_isvalid(textureIndex) || any(uvTile != int2(0)) || frame != 0.0)
        return int2(0);
    uint width;
    uint height;
    mdl_texture_dimensions(textureIndex, width, height);
    return int2(width, height);
}

int tex_width_2d(int textureIndex, int2 uvTile, float frame)
{
    return tex_res_2d(textureIndex, uvTile, frame).x;
}

int tex_height_2d(int textureIndex, int2 uvTile, float frame)
{
    return tex_res_2d(textureIndex, uvTile, frame).y;
}

int tex_first_frame_2d(int textureIndex)
{
    return 0;
}

int tex_last_frame_2d(int textureIndex)
{
    return 0;
}

float4 tex_lookup_float4_2d(
    int textureIndex,
    float2 coordinate,
    int wrapU,
    int wrapV,
    float2 cropU,
    float2 cropV,
    float frame)
{
    if (!tex_texture_isvalid(textureIndex) || frame != 0.0 || mdl_texture_clip(coordinate, wrapU, wrapV))
        return float4(0.0);
    uint width;
    uint height;
    mdl_texture_dimensions(textureIndex, width, height);
    coordinate.x = mdl_apply_wrap_and_crop(coordinate.x, wrapU, cropU, width);
    coordinate.y = mdl_apply_wrap_and_crop(coordinate.y, wrapV, cropV, height);
    coordinate = mdl_apply_smootherstep_filter(coordinate, uint2(width, height));
    // Source images are uploaded in their conventional top-left row order;
    // MDL texture coordinates are lower-left.  falcor2 performs this same
    // conversion in TextureHandle::sample for a lower-left scene.
    coordinate.y = 1.0 - coordinate.y;
    return mdl_texture_sample_level(textureIndex, coordinate);
}

float3 tex_lookup_float3_2d(int textureIndex, float2 coordinate, int wrapU, int wrapV, float2 cropU, float2 cropV, float frame)
{
    return tex_lookup_float4_2d(textureIndex, coordinate, wrapU, wrapV, cropU, cropV, frame).xyz;
}

float3 tex_lookup_color_2d(int textureIndex, float2 coordinate, int wrapU, int wrapV, float2 cropU, float2 cropV, float frame)
{
    return tex_lookup_float4_2d(textureIndex, coordinate, wrapU, wrapV, cropU, cropV, frame).xyz;
}

float2 tex_lookup_float2_2d(int textureIndex, float2 coordinate, int wrapU, int wrapV, float2 cropU, float2 cropV, float frame)
{
    return tex_lookup_float4_2d(textureIndex, coordinate, wrapU, wrapV, cropU, cropV, frame).xy;
}

float tex_lookup_float_2d(int textureIndex, float2 coordinate, int wrapU, int wrapV, float2 cropU, float2 cropV, float frame)
{
    return tex_lookup_float4_2d(textureIndex, coordinate, wrapU, wrapV, cropU, cropV, frame).x;
}

float4 tex_lookup_deriv_float4_2d(
    int textureIndex,
    Derived_float2 coordinate,
    int wrapU,
    int wrapV,
    float2 cropU,
    float2 cropV,
    float frame)
{
    if (!tex_texture_isvalid(textureIndex) || frame != 0.0 || mdl_texture_clip(coordinate.val, wrapU, wrapV))
        return float4(0.0);
    uint width;
    uint height;
    mdl_texture_dimensions(textureIndex, width, height);
    coordinate.val.x = mdl_apply_wrap_and_crop(coordinate.val.x, wrapU, cropU, width);
    coordinate.val.y = mdl_apply_wrap_and_crop(coordinate.val.y, wrapV, cropV, height);
    coordinate.val = mdl_apply_smootherstep_filter(coordinate.val, uint2(width, height));
    coordinate.val.y = 1.0 - coordinate.val.y;
    coordinate.dx.y = -coordinate.dx.y;
    coordinate.dy.y = -coordinate.dy.y;
    return mdl_texture_sample_grad(textureIndex, coordinate.val, coordinate.dx, coordinate.dy);
}

float3 tex_lookup_deriv_float3_2d(int textureIndex, Derived_float2 coordinate, int wrapU, int wrapV, float2 cropU, float2 cropV, float frame)
{
    return tex_lookup_deriv_float4_2d(textureIndex, coordinate, wrapU, wrapV, cropU, cropV, frame).xyz;
}

float3 tex_lookup_deriv_color_2d(int textureIndex, Derived_float2 coordinate, int wrapU, int wrapV, float2 cropU, float2 cropV, float frame)
{
    return tex_lookup_deriv_float4_2d(textureIndex, coordinate, wrapU, wrapV, cropU, cropV, frame).xyz;
}

float2 tex_lookup_deriv_float2_2d(int textureIndex, Derived_float2 coordinate, int wrapU, int wrapV, float2 cropU, float2 cropV, float frame)
{
    return tex_lookup_deriv_float4_2d(textureIndex, coordinate, wrapU, wrapV, cropU, cropV, frame).xy;
}

float tex_lookup_deriv_float_2d(int textureIndex, Derived_float2 coordinate, int wrapU, int wrapV, float2 cropU, float2 cropV, float frame)
{
    return tex_lookup_deriv_float4_2d(textureIndex, coordinate, wrapU, wrapV, cropU, cropV, frame).x;
}

float4 tex_texel_float4_2d(int textureIndex, int2 coordinate, int2 uvTile, float frame)
{
    const int2 size = tex_res_2d(textureIndex, uvTile, frame);
    if (any(coordinate < int2(0)) || any(coordinate >= size))
        return float4(0.0);
    return mdl_texture_load(textureIndex, coordinate);
}

float3 tex_texel_float3_2d(int textureIndex, int2 coordinate, int2 uvTile, float frame)
{
    return tex_texel_float4_2d(textureIndex, coordinate, uvTile, frame).xyz;
}

float3 tex_texel_color_2d(int textureIndex, int2 coordinate, int2 uvTile, float frame)
{
    return tex_texel_float4_2d(textureIndex, coordinate, uvTile, frame).xyz;
}

float2 tex_texel_float2_2d(int textureIndex, int2 coordinate, int2 uvTile, float frame)
{
    return tex_texel_float4_2d(textureIndex, coordinate, uvTile, frame).xy;
}

float tex_texel_float_2d(int textureIndex, int2 coordinate, int2 uvTile, float frame)
{
    return tex_texel_float4_2d(textureIndex, coordinate, uvTile, frame).x;
}

void mdl_texture_dimensions_3d(int textureIndex, out uint width, out uint height, out uint depth)
{
    width = 0;
    height = 0;
    depth = 0;
    switch (textureIndex)
    {
#if NCLS_MDL_TEXTURE_COUNT > 0
    case 1: gMdlTexture3D0.GetDimensions(width, height, depth); return;
#endif
#if NCLS_MDL_TEXTURE_COUNT > 1
    case 2: gMdlTexture3D1.GetDimensions(width, height, depth); return;
#endif
#if NCLS_MDL_TEXTURE_COUNT > 2
    case 3: gMdlTexture3D2.GetDimensions(width, height, depth); return;
#endif
#if NCLS_MDL_TEXTURE_COUNT > 3
