// Project-owned renderer callbacks for MDL SDK generated HLSL.
// The MDL target-code types are supplied by the pinned SDK before this source.

#ifndef NCLS_MDL_TEXTURE_COUNT
#define NCLS_MDL_TEXTURE_COUNT 1
#endif

StructuredBuffer<float4> gMdlArgumentBlock;
StructuredBuffer<float4> gMdlRoData;
SamplerState gMdlTextureSampler;
#if NCLS_MDL_TEXTURE_COUNT > 0
Texture2D<float4> gMdlTexture2D0;
Texture3D<float4> gMdlTexture3D0;
#endif
#if NCLS_MDL_TEXTURE_COUNT > 1
