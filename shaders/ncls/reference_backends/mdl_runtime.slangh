void mdl_texture_dimensions(int textureIndex, out uint width, out uint height)
{
    width = 0;
    height = 0;
    switch (textureIndex)
    {
#if NCLS_MDL_TEXTURE_COUNT > 0
    case 1: gMdlTexture2D0.GetDimensions(width, height); return;
#endif
#if NCLS_MDL_TEXTURE_COUNT > 1
    case 2: gMdlTexture2D1.GetDimensions(width, height); return;
#endif
#if NCLS_MDL_TEXTURE_COUNT > 2
    case 3: gMdlTexture2D2.GetDimensions(width, height); return;
#endif
#if NCLS_MDL_TEXTURE_COUNT > 3
    case 4: gMdlTexture2D3.GetDimensions(width, height); return;
#endif
#if NCLS_MDL_TEXTURE_COUNT > 4
    case 5: gMdlTexture2D4.GetDimensions(width, height); return;
#endif
#if NCLS_MDL_TEXTURE_COUNT > 5
    case 6: gMdlTexture2D5.GetDimensions(width, height); return;
#endif
#if NCLS_MDL_TEXTURE_COUNT > 6
    case 7: gMdlTexture2D6.GetDimensions(width, height); return;
#endif
#if NCLS_MDL_TEXTURE_COUNT > 7
    case 8: gMdlTexture2D7.GetDimensions(width, height); return;
#endif
#if NCLS_MDL_TEXTURE_COUNT > 8
    case 9: gMdlTexture2D8.GetDimensions(width, height); return;
#endif
#if NCLS_MDL_TEXTURE_COUNT > 9
    case 10: gMdlTexture2D9.GetDimensions(width, height); return;
#endif
#if NCLS_MDL_TEXTURE_COUNT > 10
    case 11: gMdlTexture2D10.GetDimensions(width, height); return;
#endif
#if NCLS_MDL_TEXTURE_COUNT > 11
    case 12: gMdlTexture2D11.GetDimensions(width, height); return;
#endif
#if NCLS_MDL_TEXTURE_COUNT > 12
    case 13: gMdlTexture2D12.GetDimensions(width, height); return;
#endif
#if NCLS_MDL_TEXTURE_COUNT > 13
    case 14: gMdlTexture2D13.GetDimensions(width, height); return;
#endif
#if NCLS_MDL_TEXTURE_COUNT > 14
    case 15: gMdlTexture2D14.GetDimensions(width, height); return;
#endif
#if NCLS_MDL_TEXTURE_COUNT > 15
    case 16: gMdlTexture2D15.GetDimensions(width, height); return;
#endif
    default: return;
    }
}

