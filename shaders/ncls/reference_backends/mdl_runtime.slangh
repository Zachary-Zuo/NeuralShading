float4 mdl_texture_load_3d(int textureIndex, int3 coordinate)
{
    switch (textureIndex)
    {
#if NCLS_MDL_TEXTURE_COUNT > 0
    case 1: return gMdlTexture3D0.Load(int4(coordinate, 0));
#endif
