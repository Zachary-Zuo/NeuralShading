{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unified offline cook config v1",
  "type": "object",
  "required": [
    "schema", "name", "seed", "steps", "batch_size", "learning_rate",
    "gradient_clip", "latent_initialization", "evaluation_roles"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "unified-offline-cook"},
        "version": {"const": 1}
      },
      "additionalProperties": false
    },
    "name": {"const": "unified-offline-cook-v1"},
    "seed": {"const": 20260824},
    "steps": {"const": 2000},
    "batch_size": {"const": 16},
    "learning_rate": {"const": 0.01},
    "gradient_clip": {"const": 5.0},
    "latent_initialization": {"const": "zero-v1"},
    "evaluation_roles": {
      "type": "array",
      "prefixItems": [{"const": "validation"}, {"const": "dense_slice"}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    }
  },
  "additionalProperties": false
}
