{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ncls.training-config@5",
  "type": "object",
  "required": [
    "schema_name", "schema_version", "pipeline_id", "research_stage", "model_parameters",
    "dataset_selection", "steps", "batch_size", "learning_rate", "learning_rate_schedule",
    "final_learning_rate_fraction", "weight_decay", "gradient_clip", "validation_interval",
    "checkpoint_interval", "max_validation_query_groups", "seed", "deterministic",
    "selection_metric"
  ],
  "properties": {
    "schema_name": {"const": "ncls.training-config"},
    "schema_version": {"const": 5},
    "pipeline_id": {"type": "string", "pattern": "@[^@]+$"},
    "research_stage": {"type": "string", "minLength": 1},
    "model_parameters": {"type": "object"},
    "dataset_selection": {
      "type": "object",
      "properties": {
        "state_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "asset_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "family_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "steps": {"type": "integer", "minimum": 1},
    "batch_size": {"type": "integer", "minimum": 1},
    "learning_rate": {"type": "number", "exclusiveMinimum": 0},
    "learning_rate_schedule": {"enum": ["constant", "cosine"]},
    "final_learning_rate_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "weight_decay": {"type": "number", "minimum": 0},
    "gradient_clip": {"type": "number", "exclusiveMinimum": 0},
    "validation_interval": {"type": "integer", "minimum": 1},
    "checkpoint_interval": {"type": "integer", "minimum": 1},
    "max_validation_query_groups": {"type": "integer", "minimum": 1},
    "seed": {"type": "integer", "minimum": 0},
    "device": {"type": ["string", "null"]},
    "deterministic": {"type": "boolean"},
    "selection_metric": {"type": "string", "pattern": "^[^.]+\\.[^.]+$"}
  },
  "additionalProperties": false
}
