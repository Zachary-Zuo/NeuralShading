{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrainingConfig v1",
  "type": "object",
  "required": ["pipeline", "stage", "model"],
  "properties": {
    "pipeline": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "minLength": 1},
    "capacity": {"type": "string", "minLength": 1},
    "model": {"type": "object"},
    "dataset_selection": {"type": "object"},
    "steps": {"type": "integer", "minimum": 1},
    "batch_size": {"type": "integer", "minimum": 1},
    "learning_rate": {"type": "number", "exclusiveMinimum": 0},
    "learning_rate_schedule": {"enum": ["constant", "cosine"]},
    "final_learning_rate_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "optimizer": {"enum": ["adam", "adamw"]},
    "adam_beta1": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
    "adam_beta2": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
    "adam_epsilon": {"type": "number", "exclusiveMinimum": 0},
    "weight_decay": {"type": "number", "minimum": 0},
    "gradient_clip": {"type": "number", "exclusiveMinimum": 0},
    "validation_interval": {"type": "integer", "minimum": 1},
    "checkpoint_interval": {"type": "integer", "minimum": 1},
    "minimum_steps": {"type": "integer", "minimum": 0},
    "early_stopping_patience": {"type": ["integer", "null"], "minimum": 1},
    "seed": {"type": "integer", "minimum": 0},
    "device": {"type": ["string", "null"]},
    "deterministic": {"type": "boolean"},
    "initialization_checkpoint": {"type": ["string", "null"]},
    "checkpoint_selection": {"enum": ["median_then_p95", "tail_guard"]},
    "schema_name": {"const": "training-config"},
    "schema_version": {"const": 1}
  },
  "additionalProperties": false
}
