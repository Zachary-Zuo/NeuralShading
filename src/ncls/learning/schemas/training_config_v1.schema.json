{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "ncls.training-config@1",
  "type": "object", "additionalProperties": false,
  "required": ["format_name", "format_version", "method_key", "batch_source", "model_context", "phases", "batch_size", "seed", "device", "optimizer", "validation", "checkpoint_selection"],
  "properties": {
    "format_name": {"const": "ncls.training-config"}, "format_version": {"const": 1},
    "method_key": {"type": "string", "minLength": 1},
    "batch_source": {"type": "object", "additionalProperties": false, "required": ["kind", "options"], "properties": {"kind": {"enum": ["offline", "live"]}, "options": {"type": "object"}}},
    "model_context": {"type": "object"},
    "phases": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "steps", "learning_rate"], "properties": {"name": {"enum": ["evaluator", "joint", "sampler"]}, "steps": {"type": "integer", "minimum": 1}, "learning_rate": {"type": "number", "exclusiveMinimum": 0}}}},
    "batch_size": {"type": "integer", "minimum": 1}, "seed": {"type": "integer", "minimum": 0}, "device": {"type": "string", "minLength": 1},
    "optimizer": {"type": "object", "additionalProperties": false, "required": ["kind", "weight_decay"], "properties": {"kind": {"const": "adamw"}, "weight_decay": {"type": "number", "minimum": 0}}},
    "validation": {"type": "object", "additionalProperties": false, "required": ["interval", "batches"], "properties": {"interval": {"type": "integer", "minimum": 1}, "batches": {"type": "integer", "minimum": 1}}},
    "checkpoint_selection": {"const": "tail_guard"}
  }
}
