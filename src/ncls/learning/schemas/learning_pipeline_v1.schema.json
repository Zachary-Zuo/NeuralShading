{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ncls.learning-pipeline@1",
  "type": "object",
  "required": [
    "format_name", "format_version", "pipeline_id", "candidate_id", "research_role",
    "response_reader_id", "source_adapter_id", "feature_transform_id", "target_transform_id",
    "representation_id", "architecture_id", "latent_inference_id", "compiler_id", "loss_id",
    "metric_suite_id", "exporter_id", "supported_family_ids", "scope"
  ],
  "properties": {
    "format_name": {"const": "ncls.learning-pipeline"},
    "format_version": {"const": 1},
    "pipeline_id": {"type": "string", "pattern": "@[^@]+$"},
    "candidate_id": {"type": "string", "pattern": "@[^@]+$"},
    "research_role": {"type": "string", "minLength": 1},
    "response_reader_id": {"type": "string", "pattern": "@[^@]+$"},
    "source_adapter_id": {"type": "string", "pattern": "@[^@]+$"},
    "feature_transform_id": {"type": "string", "pattern": "@[^@]+$"},
    "target_transform_id": {"type": "string", "pattern": "@[^@]+$"},
    "representation_id": {"type": "string", "pattern": "@[^@]+$"},
    "architecture_id": {"type": "string", "pattern": "@[^@]+$"},
    "latent_inference_id": {"type": "string", "pattern": "@[^@]+$"},
    "compiler_id": {"type": "string", "pattern": "@[^@]+$"},
    "loss_id": {"type": "string", "pattern": "@[^@]+$"},
    "metric_suite_id": {"type": "string", "pattern": "@[^@]+$"},
    "exporter_id": {"type": "string", "pattern": "@[^@]+$"},
    "supported_family_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "scope": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
