{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ncls.training-config@2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_name", "format_version", "method_key", "run_class", "correspondence_id", "recipe_id",
    "source_adaptation_id", "batch_source", "model_context", "lifecycle", "routes",
    "seed", "device", "optimizer", "schedule", "mollification", "filtering", "loss",
    "validation", "checkpoint_selection"
  ],
  "properties": {
    "format_name": {"const": "ncls.training-config"},
    "format_version": {"const": 2},
    "method_key": {"type": "string", "minLength": 1},
    "run_class": {"enum": ["smoke", "profile", "adapted", "formal"]},
    "correspondence_id": {"type": "string", "minLength": 1},
    "recipe_id": {"type": "string", "minLength": 1},
    "source_adaptation_id": {"type": "string", "minLength": 1},
    "batch_source": {"type": "object"},
    "model_context": {"type": "object"},
    "lifecycle": {"type": "object"},
    "routes": {"type": "array", "minItems": 1},
    "seed": {"type": "integer", "minimum": 0},
    "device": {"type": "string", "minLength": 1},
    "optimizer": {"type": "object"},
    "schedule": {"type": "object"},
    "mollification": {"type": "object"},
    "filtering": {"type": "object"},
    "loss": {"type": "object"},
    "validation": {"type": "object"},
    "checkpoint_selection": {"const": "tail_guard"}
  }
}
