{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuralshading.local/schemas/method_bundle_v1.schema.json",
  "title": "NeuralShading MethodBundle manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_name", "format_version", "method_id", "display_name", "created_at",
    "source_git_commit", "material_program_schema_versions", "supported_ir_ids",
    "scattering_contract_version", "backend_id", "backend_version", "backend_descriptor",
    "runtime_class", "compiler", "runtime", "capabilities", "cost_claims",
    "training_provenance", "validation_provenance", "files", "content_hashes"
  ],
  "properties": {
    "format_name": {"const": "ncls.method-bundle"},
    "format_version": {"const": 1},
    "method_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "display_name": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "source_git_commit": {"type": "string", "minLength": 1},
    "material_program_schema_versions": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
    "supported_ir_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "scattering_contract_version": {"const": 1},
    "backend_id": {"type": "string"},
    "backend_version": {"type": "integer", "minimum": 1},
    "backend_descriptor": {"type": "object"},
    "runtime_class": {"enum": ["realtime", "diagnostic"]},
    "compiler": {"type": "object"},
    "runtime": {"type": "object"},
    "capabilities": {"type": "object"},
    "cost_claims": {"type": "object"},
    "training_provenance": {"type": "object"},
    "validation_provenance": {"type": "object"},
    "files": {"type": "object"},
    "content_hashes": {"type": "object"}
  }
}
