{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ncls.scattering-package@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_name", "format_version", "package_id", "program_runtime_id", "material_asset_id", "program_kind", "program_key", "program_version", "program_descriptor_sha256", "source_family_id", "source_contract_version", "source_snapshot_id", "scattering_contract_version", "runtime_abi", "capabilities", "program", "material", "validation", "provenance", "files", "content_hashes"],
  "properties": {
    "format_name": {"const": "ncls.scattering-package"}, "format_version": {"const": 1},
    "package_id": {"$ref": "#/$defs/hash"}, "program_runtime_id": {"$ref": "#/$defs/hash"},
    "material_asset_id": {"$ref": "#/$defs/hash"}, "program_kind": {"enum": ["reference", "method"]},
    "program_key": {"type": "string", "minLength": 1}, "program_version": {"type": "integer", "minimum": 1},
    "program_descriptor_sha256": {"$ref": "#/$defs/hash"}, "source_family_id": {"type": "string", "minLength": 1},
    "source_contract_version": {"type": "integer", "minimum": 1}, "source_snapshot_id": {"$ref": "#/$defs/hash"},
    "scattering_contract_version": {"const": 1}, "runtime_abi": {"type": "string", "minLength": 1},
    "capabilities": {"type": "integer", "minimum": 1}, "program": {"type": "object"},
    "material": {"type": "object"}, "validation": {"type": "object"}, "provenance": {"type": "object"},
    "files": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "content_hashes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hash"}}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
