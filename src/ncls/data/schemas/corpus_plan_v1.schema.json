{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CorpusPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "name", "seed", "provider", "sampling", "split",
    "reference_budget", "shards"
  ],
  "properties": {
    "schema": {"const": {"name": "corpus-plan", "version": 1}},
    "name": {"const": "layer-stack-v1"},
    "seed": {"const": 20260824},
    "provider": {
      "const": {
        "name": "layer-stack",
        "state_profile": "layer-stack-v1",
        "family_count": 28,
        "states_per_family": 10,
        "maximum_path_depth": 64
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "wo", "transmission", "moving_peak", "dense_promotions",
        "train", "roles"
      ],
      "properties": {
        "name": {"const": "peak-aware-v1"},
        "wo": {
          "const": {
            "distribution": "stratified-cosine",
            "grazing_fraction": 0.2,
            "grazing_band_degrees": [75.0, 89.0]
          }
        },
        "transmission": {
          "const": {
            "additional_views": 32,
            "direction_multiplier": 1.5,
            "transmission_peak_weight": 0.25,
            "critical_band_weight": 0.1,
            "critical_view_band_degrees": [35.0, 55.0],
            "critical_wi_abs_cosine_band": [0.65, 0.85]
          }
        },
        "moving_peak": {
          "const": {
            "name": "reference-peak-v1",
            "probe_directions": 4096,
            "samples_per_replica": 64
          }
        },
        "dense_promotions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "train": {
          "const": {
            "W": {
              "views": 48,
              "directions": 512,
              "proposal": "peak-aware",
              "components": {"uniform": 0.6, "reflection_peak": 0.25, "grazing": 0.15}
            },
            "G": {
              "views": 64,
              "directions": 1024,
              "proposal": "peak-aware",
              "components": {"uniform": 0.4, "reflection_peak": 0.4, "grazing": 0.2}
            },
            "S": {
              "views": 96,
              "directions": 2048,
              "proposal": "peak-aware",
              "components": {"uniform": 0.3, "reflection_peak": 0.5, "grazing": 0.2}
            }
          }
        },
        "roles": {
          "const": {
            "validation": {"views": 16, "directions": 256, "proposal": "uniform"},
            "test": {"views": 24, "directions": 512, "proposal": "uniform"},
            "adversarial_probe": {
              "views": 16,
              "directions": 128,
              "proposal": "adversarial",
              "components": {"uniform": 0.2, "reflection_peak": 0.55, "grazing": 0.25}
            },
            "dense_slice": {"views": 4, "directions": 8192, "proposal": "uniform"}
          }
        }
      }
    },
    "split": {
      "const": {
        "name": "parametric-v1",
        "heldout_family_count": 4,
        "validation_states_per_fitted_family": 1,
        "test_states_per_fitted_family": 1,
        "minimum_test_state_count": 50
      }
    },
    "reference_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "double_replica", "target_relative_se_p95",
        "maximum_query_group_relative_se_p95", "minimum_combined_samples",
        "maximum_combined_samples", "reciprocal_target_relative_se_p95",
        "reciprocal_maximum_query_group_relative_se_p95",
        "reciprocal_maximum_combined_samples", "diagnostic_query_roles",
        "diagnostic_target_relative_se_p95",
        "diagnostic_maximum_query_group_relative_se_p95",
        "diagnostic_maximum_combined_samples", "training_target_relative_se_p95",
        "training_maximum_query_group_relative_se_p95",
        "training_maximum_combined_samples",
        "training_reciprocal_target_relative_se_p95",
        "training_reciprocal_maximum_query_group_relative_se_p95",
        "training_reciprocal_maximum_combined_samples",
        "diagnostic_reciprocal_target_relative_se_p95",
        "diagnostic_reciprocal_maximum_query_group_relative_se_p95",
        "diagnostic_reciprocal_maximum_combined_samples",
        "state_sample_promotions",
        "batch_samples_per_replica", "maximum_dispatch_queries"
      ],
      "properties": {
        "name": {"const": "adaptive-v1"},
        "double_replica": {"const": true},
        "target_relative_se_p95": {"const": 0.04},
        "maximum_query_group_relative_se_p95": {"const": 0.1},
        "minimum_combined_samples": {"const": 1024},
        "maximum_combined_samples": {"const": 262144},
        "reciprocal_target_relative_se_p95": {"const": 0.2},
        "reciprocal_maximum_query_group_relative_se_p95": {"const": 0.999},
        "reciprocal_maximum_combined_samples": {"const": 65536},
        "diagnostic_query_roles": {"const": ["adversarial_probe", "dense_slice"]},
        "diagnostic_target_relative_se_p95": {"const": 0.08},
        "diagnostic_maximum_query_group_relative_se_p95": {"const": 0.5},
        "diagnostic_maximum_combined_samples": {"const": 262144},
        "training_target_relative_se_p95": {"const": 0.06},
        "training_maximum_query_group_relative_se_p95": {"const": 0.25},
        "training_maximum_combined_samples": {"const": 262144},
        "training_reciprocal_target_relative_se_p95": {"const": 0.5},
        "training_reciprocal_maximum_query_group_relative_se_p95": {"const": 0.999},
        "training_reciprocal_maximum_combined_samples": {"const": 4096},
        "diagnostic_reciprocal_target_relative_se_p95": {"const": 0.2},
        "diagnostic_reciprocal_maximum_query_group_relative_se_p95": {"const": 0.999},
        "diagnostic_reciprocal_maximum_combined_samples": {"const": 65536},
        "state_sample_promotions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state_id", "maximum_combined_samples",
              "maximum_query_group_relative_se_p95", "query_roles"
            ],
            "properties": {
              "state_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "maximum_combined_samples": {
                "type": "integer", "minimum": 262144, "maximum": 4194304,
                "multipleOf": 512
              },
              "maximum_query_group_relative_se_p95": {
                "type": "number", "minimum": 0.1, "exclusiveMaximum": 1.0
              },
              "query_roles": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"enum": ["train", "validation", "test"]}
              }
            }
          }
        },
        "batch_samples_per_replica": {"const": 256},
        "maximum_dispatch_queries": {"const": 4096}
      }
    },
    "shards": {
      "const": {
        "name": "family-role-v1",
        "resume": "verified-file",
        "manifest": "reference-corpus"
      }
    }
  }
}
