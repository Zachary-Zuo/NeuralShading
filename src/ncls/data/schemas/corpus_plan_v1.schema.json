{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CorpusPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "name", "seed", "provider", "sampling", "split",
    "reference_budget", "shards"
  ],
  "properties": {
    "schema": {"const": {"name": "corpus-plan", "version": 1}},
    "name": {"const": "layer-stack-v1"},
    "seed": {"const": 20260824},
    "provider": {
      "const": {
        "name": "layer-stack",
        "state_profile": "layer-stack-v1",
        "family_count": 28,
        "states_per_family": 10,
        "maximum_path_depth": 64
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "wo", "transmission", "moving_peak", "dense_promotions",
        "train", "roles"
      ],
      "properties": {
        "name": {"const": "peak-aware-v1"},
        "wo": {
          "const": {
            "distribution": "stratified-cosine",
            "grazing_fraction": 0.2,
            "grazing_band_degrees": [75.0, 89.0]
          }
        },
        "transmission": {
          "const": {
            "additional_views": 32,
            "direction_multiplier": 1.5,
            "transmission_peak_weight": 0.25,
            "critical_band_weight": 0.1,
            "critical_view_band_degrees": [35.0, 55.0],
            "critical_wi_abs_cosine_band": [0.65, 0.85]
          }
        },
        "moving_peak": {
          "const": {
            "name": "reference-peak-v1",
            "probe_directions": 4096,
            "samples_per_replica": 64
          }
        },
        "dense_promotions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "train": {
          "const": {
            "W": {
              "views": 48,
              "directions": 512,
              "proposal": "peak-aware",
              "components": {"uniform": 0.6, "reflection_peak": 0.25, "grazing": 0.15}
            },
            "G": {
              "views": 64,
              "directions": 1024,
              "proposal": "peak-aware",
              "components": {"uniform": 0.4, "reflection_peak": 0.4, "grazing": 0.2}
            },
            "S": {
              "views": 96,
              "directions": 2048,
              "proposal": "peak-aware",
              "components": {"uniform": 0.3, "reflection_peak": 0.5, "grazing": 0.2}
            }
          }
        },
        "roles": {
          "const": {
            "validation": {"views": 16, "directions": 256, "proposal": "uniform"},
            "test": {"views": 24, "directions": 512, "proposal": "uniform"},
            "adversarial_probe": {
              "views": 16,
              "directions": 128,
              "proposal": "adversarial",
              "components": {"uniform": 0.2, "reflection_peak": 0.55, "grazing": 0.25}
            },
            "dense_slice": {"views": 4, "directions": 8192, "proposal": "uniform"}
          }
        }
      }
    },
    "split": {
      "const": {
        "name": "parametric-v1",
        "heldout_family_count": 4,
        "validation_states_per_fitted_family": 1,
        "test_states_per_fitted_family": 1,
        "minimum_test_state_count": 50
      }
    },
    "reference_budget": {
      "const": {
        "name": "adaptive-v1",
        "double_replica": true,
        "target_relative_se_p95": 0.04,
        "maximum_query_group_relative_se_p95": 0.1,
        "minimum_combined_samples": 1024,
        "maximum_combined_samples": 262144,
        "batch_samples_per_replica": 256,
        "maximum_dispatch_queries": 4096
      }
    },
    "shards": {
      "const": {
        "name": "family-role-v1",
        "resume": "verified-file",
        "manifest": "reference-corpus"
      }
    }
  }
}
