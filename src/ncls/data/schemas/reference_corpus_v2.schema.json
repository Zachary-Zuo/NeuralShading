{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReferenceCorpus v2 selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name", "plan", "plan_sha256", "selection", "selection_sha256",
    "created_at", "shards", "corpus_id", "format_name", "format_version", "totals"
  ],
  "properties": {
    "name": {"const": "layer-stack-p1-v1"},
    "plan": {"type": "object"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "selection": {"type": "object"},
    "selection_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "format": "date-time"},
    "corpus_id": {"$ref": "#/$defs/sha256"},
    "format_name": {"const": "reference-corpus"},
    "format_version": {"const": 2},
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seconds", "combined_reference_samples", "reciprocal_combined_reference_samples"
      ],
      "properties": {
        "seconds": {"type": "number", "minimum": 0},
        "combined_reference_samples": {"type": "integer", "minimum": 0},
        "reciprocal_combined_reference_samples": {"type": "integer", "minimum": 0}
      }
    },
    "shards": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "reference_corpus_v1.schema.json#/properties/shards/items"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
