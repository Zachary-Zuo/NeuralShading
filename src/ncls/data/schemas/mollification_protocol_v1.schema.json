{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Directional mollification adequacy protocol v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "name", "seed", "base_corpus_uri", "representative_states",
    "anchor_selection", "curriculum", "reference_budget", "reconstruction",
    "adequacy_gates", "supplement"
  ],
  "properties": {
    "schema": {"const": {"name": "mollification-protocol", "version": 1}},
    "name": {"const": "layer-stack-p1-mollification-adequacy-v1"},
    "seed": {"const": 20260825},
    "base_corpus_uri": {"const": "artifacts/corpus/layer-stack-p1-v1.json"},
    "representative_states": {
      "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true,
      "prefixItems": [
        {"$ref": "#/$defs/diffuse"},
        {"$ref": "#/$defs/narrow"},
        {"$ref": "#/$defs/tailConductor"},
        {"$ref": "#/$defs/tailDiffuseA"},
        {"$ref": "#/$defs/tailSheen"},
        {"$ref": "#/$defs/tailDiffuseB"}
      ],
      "items": false
    },
    "anchor_selection": {
      "type": "object", "additionalProperties": false,
      "required": [
        "dense_view_count", "light_roles", "shoulder_degrees",
        "grazing_light_z", "background_light_z", "fallback"
      ],
      "properties": {
        "dense_view_count": {"const": 4},
        "light_roles": {"const": ["peak", "shoulder", "grazing-light", "background"]},
        "shoulder_degrees": {"const": [2.0, 5.0]},
        "grazing_light_z": {"const": [0.02, 0.15]},
        "background_light_z": {"const": [0.4, 0.8]},
        "fallback": {"const": "nearest-band-center-then-source-index-v1"}
      }
    },
    "curriculum": {
      "type": "object", "additionalProperties": false,
      "required": [
        "progress", "radius_degrees", "zero_radius_switch_progress",
        "jitter_count", "sequence", "mollified_direction"
      ],
      "properties": {
        "progress": {"const": [0.0, 0.25, 0.5, 0.75]},
        "radius_degrees": {"const": [10.0, 8.535533905932738, 5.0, 1.4644660940672627]},
        "zero_radius_switch_progress": {"const": 0.875},
        "jitter_count": {"const": 256},
        "sequence": {"const": "scrambled-hammersley-upper-cap-v1"},
        "mollified_direction": {"const": "wo"}
      }
    },
    "reference_budget": {
      "type": "object", "additionalProperties": false,
      "required": [
        "replica_count", "audit_paths_per_jitter_per_replica",
        "maximum_path_depth", "maximum_dispatch_queries"
      ],
      "properties": {
        "replica_count": {"const": 2},
        "audit_paths_per_jitter_per_replica": {"const": 512},
        "maximum_path_depth": {"const": 64},
        "maximum_dispatch_queries": {"const": 4096}
      }
    },
    "reconstruction": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source_role", "embedding", "neighbors", "shepard_power",
        "support_wo_degrees", "support_wi_degrees"
      ],
      "properties": {
        "source_role": {"const": "train"},
        "embedding": {"const": "scaled-wo-wi-chord-v1"},
        "neighbors": {"const": 32},
        "shepard_power": {"const": 2.0},
        "support_wo_degrees": {"const": 2.0},
        "support_wi_degrees": {"const": 1.0}
      }
    },
    "adequacy_gates": {
      "type": "object", "additionalProperties": false,
      "required": [
        "support_fraction_minimum", "fresh_relative_se_p95_maximum",
        "normalized_rgb_l1_median_maximum", "normalized_rgb_l1_p95_maximum",
        "normalized_rgb_l1_worst_maximum", "normalization_floor",
        "repeat_float_tolerance"
      ],
      "properties": {
        "support_fraction_minimum": {"const": 0.95},
        "fresh_relative_se_p95_maximum": {"const": 0.04},
        "normalized_rgb_l1_median_maximum": {"const": 0.025},
        "normalized_rgb_l1_p95_maximum": {"const": 0.05},
        "normalized_rgb_l1_worst_maximum": {"const": 0.10},
        "normalization_floor": {"const": 1e-6},
        "repeat_float_tolerance": {"const": 1e-7}
      }
    },
    "supplement": {
      "type": "object", "additionalProperties": false,
      "required": [
        "name", "view_count", "light_count", "peak_light_count",
        "log_response_light_count", "proposal_index_light_count",
        "initial_paths_per_jitter_per_replica", "maximum_paths_per_jitter_per_replica",
        "target_relative_se_p95", "maximum_group_relative_se",
        "normalization_floor", "shard_format", "corpus_format"
      ],
      "properties": {
        "name": {"const": "layer-stack-p1-mollification-v1"},
        "view_count": {"const": 8},
        "light_count": {"const": 64},
        "peak_light_count": {"const": 16},
        "log_response_light_count": {"const": 16},
        "proposal_index_light_count": {"const": 32},
        "initial_paths_per_jitter_per_replica": {"const": 64},
        "maximum_paths_per_jitter_per_replica": {"const": 512},
        "target_relative_se_p95": {"const": 0.06},
        "maximum_group_relative_se": {"const": 0.25},
        "normalization_floor": {"const": 1e-6},
        "shard_format": {"const": {"name": "mollified-reference-shard", "version": 1}},
        "corpus_format": {"const": {"name": "mollified-reference-corpus", "version": 1}}
      }
    }
  },
  "$defs": {
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "state_id"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "state_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "diffuse": {
      "allOf": [{"$ref": "#/$defs/state"}, {"properties": {
        "role": {"const": "diffuse-control"},
        "state_id": {"const": "1b6dc2ae36e7fb076e1942242317b9af5b8bc723d71e17e5bccf33402403c49f"}
      }}]
    },
    "narrow": {
      "allOf": [{"$ref": "#/$defs/state"}, {"properties": {
        "role": {"const": "narrow-conductor-peak"},
        "state_id": {"const": "3d925881a55b0bbee135592d539b71dec694be51852793d74071d68d161ce5b5"}
      }}]
    },
    "tailConductor": {
      "allOf": [{"$ref": "#/$defs/state"}, {"properties": {
        "role": {"const": "tail-three-layer-conductor"},
        "state_id": {"const": "bd6de2e9d0cf5b32e6259d90af99b718983783cbfff1a0a9c3025a54ff3672db"}
      }}]
    },
    "tailDiffuseA": {
      "allOf": [{"$ref": "#/$defs/state"}, {"properties": {
        "role": {"const": "tail-four-layer-diffuse-a"},
        "state_id": {"const": "6fff05aa8f142b26631bd354c21c871e900a75bbd0f33e8426d3e05d73b9a3e9"}
      }}]
    },
    "tailSheen": {
      "allOf": [{"$ref": "#/$defs/state"}, {"properties": {
        "role": {"const": "tail-four-layer-sheen"},
        "state_id": {"const": "4ebd9258461716ed23d523a0b221d015feb190270471e2a55b63c3a219fcb1e7"}
      }}]
    },
    "tailDiffuseB": {
      "allOf": [{"$ref": "#/$defs/state"}, {"properties": {
        "role": {"const": "tail-four-layer-diffuse-b"},
        "state_id": {"const": "1796065779d0932fe7ded3cc2c40b84a8a19190dd7e68732f06bc518ae7fe54a"}
      }}]
    }
  }
}
