{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReferenceCorpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name", "plan", "plan_sha256", "created_at", "shards", "corpus_id",
    "format_name", "format_version", "totals"
  ],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "plan": {"type": "object"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "format": "date-time"},
    "corpus_id": {"$ref": "#/$defs/sha256"},
    "format_name": {"const": "reference-corpus"},
    "format_version": {"const": 1},
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seconds", "combined_reference_samples", "reciprocal_combined_reference_samples"
      ],
      "properties": {
        "seconds": {"type": "number", "minimum": 0},
        "combined_reference_samples": {"type": "integer", "minimum": 0},
        "reciprocal_combined_reference_samples": {"type": "integer", "minimum": 0}
      }
    },
    "shards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shard_id", "uri", "role", "structure_family_id", "difficulty_class",
          "difficulty_tags", "state_ids", "view_count", "direction_count", "status",
          "dataset_id", "sha256", "seconds", "combined_reference_samples",
          "reciprocal_combined_reference_samples"
        ],
        "properties": {
          "shard_id": {"type": "string", "minLength": 1},
          "uri": {"type": "string", "minLength": 1},
          "role": {
            "enum": ["train", "validation", "test", "adversarial_probe", "dense_slice"]
          },
          "structure_family_id": {"type": "string", "minLength": 1},
          "difficulty_class": {"type": "string", "minLength": 1},
          "difficulty_tags": {
            "type": "array", "uniqueItems": true,
            "items": {"enum": ["T", "M"]}
          },
          "state_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"$ref": "#/$defs/sha256"}
          },
          "view_count": {"type": "integer", "minimum": 1},
          "direction_count": {"type": "integer", "minimum": 1},
          "status": {"enum": ["planned", "complete"]},
          "dataset_id": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
          "sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
          "seconds": {"type": ["number", "null"], "minimum": 0},
          "combined_reference_samples": {"type": ["integer", "null"], "minimum": 0},
          "reciprocal_combined_reference_samples": {
            "type": ["integer", "null"], "minimum": 0
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
