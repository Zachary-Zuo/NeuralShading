{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Directional mollification anchor lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "protocol_uri", "protocol_sha256", "base_corpus_uri",
    "base_identity", "anchors", "frozen_at", "anchor_lock_sha256"
  ],
  "properties": {
    "schema": {"const": {"name": "mollification-anchor-lock", "version": 1}},
    "protocol_uri": {"type": "string", "minLength": 1},
    "protocol_sha256": {"$ref": "#/$defs/sha256"},
    "base_corpus_uri": {"type": "string", "minLength": 1},
    "base_identity": {"$ref": "#/$defs/baseIdentity"},
    "anchors": {
      "type": "array", "minItems": 24, "maxItems": 24,
      "items": {"$ref": "#/$defs/anchor"}
    },
    "frozen_at": {"type": "string", "format": "date-time"},
    "anchor_lock_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "vector3": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "number"}
    },
    "baseIdentity": {
      "type": "object", "additionalProperties": false,
      "required": [
        "corpus_id", "plan_sha256", "selection_sha256", "manifest_sha256", "shards"
      ],
      "properties": {
        "corpus_id": {"$ref": "#/$defs/sha256"},
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "selection_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "shards": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/baseShard"}
        }
      }
    },
    "baseShard": {
      "type": "object", "additionalProperties": false,
      "required": ["shard_id", "uri", "role", "state_ids", "dataset_id", "sha256"],
      "properties": {
        "shard_id": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "minLength": 1},
        "role": {
          "enum": ["train", "validation", "test", "adversarial_probe", "dense_slice"]
        },
        "state_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "dataset_id": {"$ref": "#/$defs/sha256"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "anchor": {
      "type": "object", "additionalProperties": false,
      "required": [
        "representative_role", "state_id", "view_index", "wo", "source", "lights"
      ],
      "properties": {
        "representative_role": {"type": "string", "minLength": 1},
        "state_id": {"$ref": "#/$defs/sha256"},
        "view_index": {"type": "integer", "minimum": 0, "maximum": 3},
        "wo": {"$ref": "#/$defs/vector3"},
        "source": {"$ref": "#/$defs/source"},
        "lights": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {"$ref": "#/$defs/light"}
        }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["shard_id", "dataset_id", "group_index"],
      "properties": {
        "shard_id": {"type": "string", "minLength": 1},
        "dataset_id": {"$ref": "#/$defs/sha256"},
        "group_index": {"type": "integer", "minimum": 0}
      }
    },
    "light": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "direction_index", "fallback_used", "wi", "source_response"],
      "properties": {
        "role": {"enum": ["peak", "shoulder", "grazing-light", "background"]},
        "direction_index": {"type": "integer", "minimum": 0},
        "fallback_used": {"type": "boolean"},
        "wi": {"$ref": "#/$defs/vector3"},
        "source_response": {"$ref": "#/$defs/vector3"}
      }
    }
  }
}
