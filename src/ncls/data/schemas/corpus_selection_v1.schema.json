{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CorpusSelection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "name", "base_corpus", "stage", "partition",
    "states_per_stratum", "strata", "state_ids"
  ],
  "properties": {
    "schema": {"const": {"name": "corpus-selection", "version": 1}},
    "name": {"const": "layer-stack-p1-v1"},
    "base_corpus": {"const": "layer-stack-v1"},
    "stage": {"const": "P1"},
    "partition": {"const": "target-visible-v1"},
    "states_per_stratum": {"const": 5},
    "strata": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["difficulty_class", "difficulty_tags"],
        "properties": {
          "difficulty_class": {"enum": ["W", "G", "S"]},
          "difficulty_tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {"const": "M"},
            "maxItems": 1
          }
        }
      }
    },
    "state_ids": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }
  }
}
