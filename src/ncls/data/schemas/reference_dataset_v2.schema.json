{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuralshading.local/schemas/reference_dataset_v2.schema.json",
  "title": "NeuralShading ReferenceDataset manifest v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "format_name",
    "format_version",
    "dataset_id",
    "created_at",
    "material_program_schema_version",
    "canonical_ir_id",
    "canonical_ir_abi_version",
    "scattering_contract_version",
    "reference_implementation_id",
    "reference_source_sha256",
    "generator_git_commit",
    "prior_id",
    "prior_version",
    "resolved_config_sha256",
    "seed",
    "direction_parameterization",
    "response_measure",
    "color_model",
    "counts",
    "shapes",
    "statistics_encoding",
    "quantization",
    "split_policy",
    "files",
    "content_hashes",
    "shards"
  ],
  "properties": {
    "format_name": {"const": "ncls.reference-dataset"},
    "format_version": {"const": 2},
    "dataset_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "minLength": 1},
    "material_program_schema_version": {"const": 1},
    "canonical_ir_id": {"const": "ncls.layer-stack-ir@1"},
    "canonical_ir_abi_version": {"const": 1},
    "scattering_contract_version": {"const": 1},
    "reference_implementation_id": {"type": "string", "minLength": 1},
    "reference_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generator_git_commit": {"type": "string", "minLength": 1},
    "prior_id": {"type": "string", "minLength": 1},
    "prior_version": {"type": "string", "minLength": 1},
    "resolved_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "seed": {"type": "integer", "minimum": 0},
    "direction_parameterization": {"type": "object"},
    "response_measure": {"const": "bsdf-times-positive-light-cosine"},
    "color_model": {"const": "linear-srgb"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_count", "material_state_count", "view_count", "light_count", "tile_count"],
      "properties": {
        "family_count": {"type": "integer", "minimum": 1},
        "material_state_count": {"type": "integer", "minimum": 1},
        "view_count": {"type": "integer", "minimum": 1},
        "light_count": {"type": "integer", "minimum": 1},
        "tile_count": {"type": "integer", "minimum": 1}
      }
    },
    "shapes": {"type": "object"},
    "statistics_encoding": {"type": "object"},
    "quantization": {"type": "object"},
    "split_policy": {"type": "object"},
    "files": {"type": "object"},
    "content_hashes": {"type": "object"},
    "shards": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  }
}
