{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ncls.mdl-compiled-artifact@1",
  "title": "Finalized MDL SDK compiled artifact",
  "type": "object",
  "required": ["schema", "mdl_sdk", "module", "material", "code", "texture_payloads", "capability_audit", "compiled_material_hash", "sub_expression_hashes", "parameters", "argument_block", "ro_data", "textures", "compiler_identity", "files_sha256", "diagnostics"],
  "properties": {
    "schema": {"const": "ncls.mdl-compiled-artifact@1"},
    "mdl_sdk": {"const": "2025.0.0-387700.1252"},
    "module": {"type": "string", "pattern": "^::"},
    "material": {"type": "string", "pattern": "^::"},
    "code": {"type": "string", "minLength": 1},
    "texture_payloads": {"enum": ["decoded", "metadata-only"]},
    "capability_audit": {
      "type": "object",
      "required": ["surface_bsdf_evaluate", "emission", "volume", "displacement", "cutout_opacity"],
      "additionalProperties": false,
      "properties": {
        "surface_bsdf_evaluate": {"const": true},
        "emission": {"const": false},
        "volume": {"const": false},
        "displacement": {"const": false},
        "cutout_opacity": {"type": "boolean"}
      }
    },
    "compiled_material_hash": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "sub_expression_hashes": {
      "type": "object",
      "required": ["surface.scattering", "geometry.normal", "geometry.cutout_opacity"],
      "additionalProperties": false,
      "properties": {
        "surface.scattering": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "geometry.normal": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "geometry.cutout_opacity": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
      }
    },
    "parameters": {"type": "array"},
    "argument_block": {"type": ["object", "null"]},
    "ro_data": {"type": "array"},
    "textures": {"type": "array"},
    "compiler_identity": {
      "type": "object",
      "required": [
        "mdl_sdk", "platform_id", "semantic_identity", "build_identity",
        "backend_manifest_sha256", "sdk_archive_sha256",
        "bridge_executable_sha256", "stb_commit", "stb_image_sha256", "codegen_options"
      ],
      "additionalProperties": false,
      "properties": {
        "mdl_sdk": {"const": "2025.0.0-387700.1252"},
        "platform_id": {"enum": ["windows-x86_64@1", "linux-x86_64@1"]},
        "semantic_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "build_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "backend_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sdk_archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bridge_executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stb_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "stb_image_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "codegen_options": {"type": "object"}
      }
    },
    "files_sha256": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "diagnostics": {"type": "string", "maxLength": 0}
  }
}
